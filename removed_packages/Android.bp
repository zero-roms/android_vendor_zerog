//
// ZeroG cut list: modules named here are left out of the image.
//
// SPDX-License-Identifier: Apache-2.0
//
// A module that "overrides" another stops the other from being installed,
// without editing the LineageOS or device makefiles that add it. This module
// installs nothing itself.
//
// Glimpse and Canvas are removed by the FossifyGallery module that replaces
// them (prebuilt/apps), so the removal and the replacement cannot be split.
// Jelly stays until Cromite is bundled, so the phone always has a browser.
//

prebuilt_etc {
    name: "ZeroGRemovedPackages",
    src: "empty",
    filename: "zerog_removed_packages",
    installable: false,
    overrides: [
        "AudioFX", // equaliser service; Twelve has its own equaliser
        "FM2",     // FM radio app; FM cut on 22 October 2026
        // FM2's library pieces, which its own module would otherwise install
        "libqcomfm_jni",
        "qcom.fmradio",
        "qcom.fmradio.xml",
    ],
}
