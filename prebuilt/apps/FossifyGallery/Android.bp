//
// Fossify Gallery (GPL-3.0), foss flavour, built from source by prebuilt/apps/build-fossify.sh
// and re-signed here with the ROM's default app key (not the platform key).
//
// SPDX-License-Identifier: Apache-2.0
//

android_app_import {
    name: "FossifyGallery",
    apk: "FossifyGallery.apk",
    default_dev_cert: true,
    product_specific: true,
    dex_preopt: {
        enabled: true,
    },
    // Replaces LineageOS's gallery and photo editor in the same step.
    overrides: [
        "Glimpse",
        "Canvas",
    ],
}
